{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ash",
  "version": "1.1.5",
  "identifier": "com.ash.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ash",
        "width": 1180,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../build/appicon.png"],
    "category": "Utility",
    "shortDescription": "A frameless terminal with a built-in AI agent",
    "longDescription": "Ash pairs a real terminal with a provider-agnostic AI agent in one desktop window."
  }
}
